# Live LotusFlare Portal (dc02 staging)
PORTAL_BASE_URL=https://portal-dc02.lotusflare.com
PORTAL_COMPANY_ID=29
PORTAL_START_PATH=/#/29
# Optional override for the saved Playwright storage state
# PORTAL_AUTH_STATE=.auth/user.json

# Midscene Vision Model (OpenAI-compatible endpoint)
# Screenshots of the staging portal are sent to this model — do not use production tenants.
# See https://www.midscenejs.com/model-selection
OPENAI_API_KEY=your-api-key-here
MIDSCENE_MODEL_NAME=gpt-4.1
# Optional: custom base URL for Qwen, Doubao, Gemini, or self-hosted VLMs
# OPENAI_BASE_URL=https://api.openai.com/v1
