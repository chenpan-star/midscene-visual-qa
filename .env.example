# Target portal URL (default points to the local visualizer demo)
PORTAL_BASE_URL=http://127.0.0.1:4173
PORTAL_START_PATH=/

# Midscene Vision Model configuration (OpenAI-compatible endpoint)
# See https://www.midscenejs.com/model-selection
OPENAI_API_KEY=your-api-key-here
MIDSCENE_MODEL_NAME=gpt-4.1
# Optional: custom base URL for Qwen, Doubao, Gemini, or self-hosted VLMs
# OPENAI_BASE_URL=https://api.openai.com/v1
