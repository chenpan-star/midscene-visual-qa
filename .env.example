# Live LotusFlare Portal (dc02 staging)
PORTAL_BASE_URL=https://portal-dc02.lotusflare.com
PORTAL_COMPANY_ID=29
PORTAL_START_PATH=/#/29

# Gemini (Google AI Studio) — create a key at https://aistudio.google.com/apikey
MIDSCENE_MODEL_FAMILY=gemini
MIDSCENE_MODEL_NAME=gemini-3.8-flash
MIDSCENE_MODEL_API_KEY=your-google-ai-studio-key
MIDSCENE_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MIDSCENE_MODEL_REASONING_ENABLED=default

# Or OpenAI instead:
# MIDSCENE_MODEL_API_KEY=sk-...
# MIDSCENE_MODEL_NAME=gpt-4.1
# MIDSCENE_MODEL_BASE_URL=https://api.openai.com/v1
# (and unset MIDSCENE_MODEL_FAMILY or set appropriately)
